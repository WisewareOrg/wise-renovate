{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "prCreation": "immediate",
  "postUpdateOptions": ["gomodTidy"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"],
    "minimumReleaseAgeBehaviour": "timestamp-optional"
  },
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^renovate\\.json$/"],
      "matchStrings": ["github>WisewareOrg/wise-renovate#(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "WisewareOrg/wise-renovate",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["uses: WisewareOrg/wise-ci/[^@]+@(?<currentDigest>[0-9a-f]{40})"],
      "depNameTemplate": "https://github.com/WisewareOrg/wise-ci",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "matchPackageNames": ["WisewareOrg/**"],
      "minimumReleaseAge": null
    },
    {
      "groupName": "node",
      "matchDatasources": ["node-version", "docker", "github-releases"],
      "matchPackageNames": ["node", "actions/node-versions"]
    },
    {
      "groupName": "wise-ci",
      "matchPackageNames": ["https://github.com/WisewareOrg/wise-ci"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["WisewareOrg/wise-ci"],
      "enabled": false
    }
  ]
}
