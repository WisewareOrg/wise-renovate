{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "postUpdateOptions": ["gomodTidy"],
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^renovate\\.json$/"],
      "matchStrings": ["github>tjwise99/wise-renovate#(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "tjwise99/wise-renovate",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchPackageNames": ["tjwise99/**"],
      "minimumReleaseAge": null
    },
    {
      "groupName": "node",
      "matchDatasources": ["node-version", "docker", "github-releases"],
      "matchPackageNames": ["node", "actions/node-versions"]
    }
  ]
}
